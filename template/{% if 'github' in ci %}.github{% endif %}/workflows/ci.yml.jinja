# Generated by devkit {{ devkit_ref }} — refreshed by `copier update`.
# GitHub only orchestrates: every job ends in `mise run <task>`.
name: ci

on:
  push:
    branches: [main]
    tags: ["*"]
  pull_request:

permissions:
  contents: read

concurrency:
  group: {% raw %}${{ github.workflow }}-${{ github.ref }}{% endraw %}
  cancel-in-progress: true

jobs:
  base:
    uses: {{ devkit_github }}/.github/workflows/base.yml@{{ devkit_ref }}
    secrets:
      # Optional: only needed when a mise git:: include points at a private repository.
      git-token: {% raw %}${{ secrets.DEVKIT_GIT_TOKEN }}{% endraw %}
{%- for s in stacks %}

  {{ s }}:
    uses: {{ devkit_github }}/.github/workflows/{{ s }}.yml@{{ devkit_ref }}
    secrets:
      git-token: {% raw %}${{ secrets.DEVKIT_GIT_TOKEN }}{% endraw %}
{%- if s == 'helm' %}
    permissions:
      contents: read
      packages: write
    with:
      publish: {% raw %}${{ startsWith(github.ref, 'refs/tags/') }}{% endraw %}
{%- endif %}
{%- endfor %}

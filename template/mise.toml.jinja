#:schema https://mise.jdx.dev/schema/mise.json
# Generated by devkit {{ devkit_ref }} — refreshed by `copier update`.
#
# Tools and env come from devkit through `include`; tasks through
# `task_config.includes`. Anything declared in this file wins over devkit:
# add a [tools] entry to pin another version, an [env] entry to change a
# default, a [tasks."lint:python"] to replace a shared task.
{%- set bricks = ['base'] + stacks %}

include = [
{%- for b in bricks %}
  "git::{{ devkit_repo }}//mise/{{ b }}/mise.toml?ref={{ devkit_ref }}",
{%- endfor %}
]

[settings]
# Tasks pulled from a git:: source are still experimental in mise.
experimental = true

[task_config]
# The last entry wins on a name clash: local tasks come after devkit's.
includes = [
{%- for b in bricks %}
  "git::{{ devkit_repo }}//mise/{{ b }}/tasks.toml?ref={{ devkit_ref }}",
{%- endfor %}
  "mise-tasks",
]
{%- set verbs = {'lint': true, 'fmt': ('python' in stacks or 'go' in stacks), 'test': true, 'build': true} %}
{%- if not stacks %}{% set verbs = {'lint': true} %}{% endif %}
{%- for verb, on in verbs.items() if on %}

[tasks.{{ verb }}]
description = "Every {{ verb }}:* task"
depends = ["{{ verb }}:*"]
{%- endfor %}

{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "devkit baseline: every project extends this, plus one preset per stack",
  "extends": [
    "config:recommended",
    ":dependencyDashboard"
  ],
  "minimumReleaseAge": "3 days",
  "customManagers": [
    {
      "customType": "regex",
      "description": "Inline hints: `# renovate: datasource=<ds> depName=<name>` on the line before a version",
      "managerFilePatterns": [
        "/\\.(ya?ml|toml|dang)$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[^\\s]+) depName=(?<depName>[^\\s]+)( versioning=(?<versioning>[^\\s]+))?\\s+[^\\n]*?[:=]\\s*[\"']?(?:[^\"'\\s]*:)?(?<currentValue>[^\"'\\s]+)[\"']?\\s"
      ],
      "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{else}}semver-coerced{{/if}}"
    },
    {
      "customType": "regex",
      "description": "mise `task_config.includes` git:: entries (devkit convention: tasks*.toml). Renovate's mise manager only reads `include` and `tasks.*.file`",
      "managerFilePatterns": [
        "/(^|/)\\.?mise(\\.[^/]+)?\\.toml$/"
      ],
      "matchStrings": [
        "\"git::(?<packageName>https://[^\"]+?\\.git)//[^\"?]*tasks[^\"?/]*\\.toml\\?ref=(?<currentValue>[^\"]+)\""
      ],
      "datasourceTemplate": "git-tags",
      "depTypeTemplate": "task-include"
    }
  ],
  "packageRules": [
    {
      "description": "Everything devkit ships moves together: mise includes, task includes, GitLab components, GitHub workflows",
      "matchPackageNames": [
        "/wihrt\\/devkit/i"
      ],
      "groupName": "devkit",
      "minimumReleaseAge": "0 days"
    }
  ]
}
